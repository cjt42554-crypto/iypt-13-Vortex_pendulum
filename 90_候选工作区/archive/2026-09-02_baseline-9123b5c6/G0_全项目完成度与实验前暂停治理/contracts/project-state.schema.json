{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iypt13:g0:project-state:v1",
  "title": "G0 project state ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ledgerId",
    "project",
    "baselineCommit",
    "generatedAt",
    "conclusionCeiling",
    "workPackages"
  ],
  "properties": {
    "schemaVersion": {"const": "G0-PROJECT-STATE-CONTRACT-v1"},
    "ledgerId": {"type": "string", "minLength": 1},
    "project": {"const": "IYPT-2027-P13-VORTEX-PENDULUM"},
    "baselineCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "conclusionCeiling": {
      "enum": [
        "NONE",
        "IMPLEMENTATION_ONLY",
        "SYNTHETIC_NUMERICAL_ONLY",
        "CANDIDATE_NUMERICAL_ONLY",
        "PUBLIC_PHYSICAL_ONLY",
        "EXPERIMENT_PREPARATION_ONLY",
        "EXPERIMENT_VALIDATED"
      ]
    },
    "workPackages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/workPackage"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "claim"],
      "properties": {
        "kind": {
          "enum": [
            "contract",
            "implementation-test",
            "numerical-qualification",
            "physical-validation",
            "experimental-validation",
            "governance",
            "runtime-observation"
          ]
        },
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "claim": {"type": "string", "minLength": 1}
      }
    },
    "workPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "owner",
        "priority",
        "status",
        "predecessors",
        "evidence",
        "terminationCode",
        "nextGate"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^WP-[A-Z0-9]+$"},
        "title": {"type": "string", "minLength": 1},
        "owner": {"enum": ["Codex", "Pro", "human", "runtime"]},
        "priority": {"enum": ["P0", "P1", "P2", "P3"]},
        "status": {
          "enum": [
            "NOT_STARTED",
            "IN_PROGRESS",
            "WAITING_PREDECESSOR",
            "PASS",
            "NO_GO",
            "INCONCLUSIVE",
            "DEFERRED_CONDITIONAL",
            "EXPERIMENT_DEPENDENT"
          ]
        },
        "predecessors": {
          "type": "array",
          "items": {"type": "string", "pattern": "^WP-[A-Z0-9]+$"},
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        },
        "terminationCode": {"type": ["string", "null"]},
        "nextGate": {"type": ["string", "null"]}
      }
    }
  }
}
