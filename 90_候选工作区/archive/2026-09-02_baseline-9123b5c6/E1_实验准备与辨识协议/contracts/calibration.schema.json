{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iypt13:e1:calibration:v1",
  "title": "Measurement channel calibration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "calibrationId",
    "apparatusId",
    "channelId",
    "channelKind",
    "method",
    "validFrom",
    "validUntil",
    "inputUnit",
    "outputUnit",
    "coefficients",
    "residualStandardUncertainty",
    "rawEvidenceHash",
    "recordHash"
  ],
  "properties": {
    "schemaVersion": {"const": "E1-CALIBRATION-v1"},
    "calibrationId": {"type": "string", "minLength": 1},
    "apparatusId": {"type": "string", "minLength": 1},
    "channelId": {"type": "string", "minLength": 1},
    "channelKind": {
      "enum": ["angle", "displacement", "flow-speed", "water-level", "load", "image", "clock", "environment"]
    },
    "method": {"type": "string", "minLength": 1},
    "validFrom": {"type": "string", "format": "date-time"},
    "validUntil": {"type": "string", "format": "date-time"},
    "inputUnit": {"type": "string", "minLength": 1},
    "outputUnit": {"type": "string", "minLength": 1},
    "coefficients": {"type": "array", "minItems": 1, "items": {"type": "number"}},
    "residualStandardUncertainty": {"type": "number", "minimum": 0},
    "rawEvidenceHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recordHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
