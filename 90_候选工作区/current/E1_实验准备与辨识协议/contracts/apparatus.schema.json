{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iypt13:e1:apparatus:v1",
  "title": "Vortex pendulum apparatus registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "apparatusId",
    "revision",
    "registeredAt",
    "bom",
    "parameters",
    "assemblyTolerances",
    "recordHash"
  ],
  "properties": {
    "schemaVersion": {"const": "E1-APPARATUS-v1"},
    "apparatusId": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "registeredAt": {"type": "string", "format": "date-time"},
    "bom": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "description", "quantity", "lotOrSerial"],
        "properties": {
          "itemId": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "quantity": {"type": "integer", "minimum": 1},
          "lotOrSerial": {"type": "string", "minLength": 1}
        }
      }
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "quantity.schema.json"}
    },
    "assemblyTolerances": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "quantity.schema.json"}
    },
    "recordHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
