{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iypt13:g0:r1i-interrupted-attempt-seal:v1",
  "title": "R1I interrupted serial attempt evidence seal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sealId",
    "recordedAt",
    "sealingBaselineCommit",
    "classification",
    "sourceIncident",
    "pr1Decision",
    "oldWorktree",
    "processes",
    "artifacts",
    "scientificBoundary",
    "routeLocks",
    "validation"
  ],
  "properties": {
    "schemaVersion": {"const": "R1I-INTERRUPTED-SERIAL-ATTEMPT-SEAL-v1"},
    "sealId": {"const": "A8R-V2P1-INTERRUPTED-SERIAL-ATTEMPT-20260831-R1I-SEAL"},
    "recordedAt": {"type": "string", "format": "date-time"},
    "sealingBaselineCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "classification": {
      "const": "PASS-R1I-INTERRUPTED-SERIAL-ATTEMPT-EVIDENCE-SEALED"
    },
    "sourceIncident": {"$ref": "#/$defs/sourceIncident"},
    "pr1Decision": {"$ref": "#/$defs/pr1Decision"},
    "oldWorktree": {"$ref": "#/$defs/oldWorktree"},
    "processes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/process"}
    },
    "artifacts": {"$ref": "#/$defs/artifacts"},
    "scientificBoundary": {"$ref": "#/$defs/scientificBoundary"},
    "routeLocks": {"$ref": "#/$defs/routeLocks"},
    "validation": {"$ref": "#/$defs/validation"}
  },
  "$defs": {
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "gitBlob"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gitBlob": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "sourceIncident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventCommit",
        "terminalIdentity",
        "terminalClassification",
        "report",
        "machineEvidence",
        "machineEvidenceSidecar"
      ],
      "properties": {
        "eventCommit": {"const": "b522f1a37814164dff18390ee23d5153d4499375"},
        "terminalIdentity": {
          "const": "A8R-V2P1-INTERRUPTED-SERIAL-ATTEMPT-20260831"
        },
        "terminalClassification": {
          "const": "INCONCLUSIVE-R0-HOST-SHUTDOWN-NO-CANONICAL-ARTIFACT"
        },
        "report": {"$ref": "#/$defs/fileIdentity"},
        "machineEvidence": {"$ref": "#/$defs/fileIdentity"},
        "machineEvidenceSidecar": {"$ref": "#/$defs/fileIdentity"}
      }
    },
    "pr1Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "commit", "path", "sha256", "gitBlob"],
      "properties": {
        "decisionId": {
          "const": "IYPT13-PR1-R0-HOST-SHUTDOWN-ROUTE-DECISION-v1"
        },
        "commit": {"const": "0f8085b1fda43e4f83d5152cfd99294bc3c0fc29"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gitBlob": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "oldWorktree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "realpath",
        "device",
        "inode",
        "directorySizeBytes",
        "branch",
        "head",
        "upstream",
        "localOriginMain",
        "ahead",
        "behind",
        "porcelainV2Entries",
        "clean",
        "originNetworkRefreshPerformedDuringR1i",
        "optionalGitLocksDisabled",
        "currentBootId",
        "currentBootStartedAt",
        "disposition",
        "mutatingCommandsExecuted",
        "reuseForbiddenFor"
      ],
      "properties": {
        "path": {"const": "/home/cjt/Desktop/iypt/13 涡流摆"},
        "realpath": {"const": "/home/cjt/Desktop/iypt/13 涡流摆"},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1},
        "directorySizeBytes": {"type": "integer", "minimum": 0},
        "branch": {"const": "main"},
        "head": {"const": "88c4e9e8ba57b02a06315679e9b30dd10999b30c"},
        "upstream": {"const": "origin/main"},
        "localOriginMain": {"const": "0c44ad25fecd82423e26fb7d6ff8dadd52d67eee"},
        "ahead": {"const": 0},
        "behind": {"type": "integer", "minimum": 1},
        "porcelainV2Entries": {"type": "array", "maxItems": 0},
        "clean": {"const": true},
        "originNetworkRefreshPerformedDuringR1i": {"const": false},
        "optionalGitLocksDisabled": {"const": true},
        "currentBootId": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
        "currentBootStartedAt": {"type": "string", "format": "date-time"},
        "disposition": {"const": "READ_ONLY_HISTORICAL_ARCHIVE_IN_PLACE"},
        "mutatingCommandsExecuted": {"type": "array", "maxItems": 0},
        "reuseForbiddenFor": {
          "type": "array",
          "prefixItems": [
            {"const": "H1"},
            {"const": "H2"},
            {"const": "HW1-primary"},
            {"const": "HW1-repeat"}
          ],
          "items": false
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "role", "state"],
      "properties": {
        "pid": {"enum": [51467, 51497, 51498]},
        "role": {"enum": ["npm", "shell-wrapper", "node-runner"]},
        "state": {"const": "ABSENT"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "state"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "state": {"const": "ABSENT"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedGzip", "expectedSidecar", "partialArtifacts", "artifactAsserterExecuted"],
      "properties": {
        "expectedGzip": {"$ref": "#/$defs/artifact"},
        "expectedSidecar": {"$ref": "#/$defs/artifact"},
        "partialArtifacts": {"type": "array", "maxItems": 0},
        "artifactAsserterExecuted": {"const": false}
      }
    },
    "scientificBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scientificPayloadInspected",
        "scientificConclusion",
        "recoverableScientificBytes",
        "creditableCompletedHw1Cases",
        "partialProgressCredit"
      ],
      "properties": {
        "scientificPayloadInspected": {"const": false},
        "scientificConclusion": {"const": "NONE"},
        "recoverableScientificBytes": {"const": 0},
        "creditableCompletedHw1Cases": {"const": 0},
        "partialProgressCredit": {"const": 0}
      }
    },
    "routeLocks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacyFullSerialRerunAuthorized",
        "checkpointResumeAuthorized",
        "oldWorktreeReuseAuthorized",
        "mixedProvenanceAuthorized",
        "nextGate"
      ],
      "properties": {
        "legacyFullSerialRerunAuthorized": {"const": false},
        "checkpointResumeAuthorized": {"const": false},
        "oldWorktreeReuseAuthorized": {"const": false},
        "mixedProvenanceAuthorized": {"const": false},
        "nextGate": {"const": "G1-AND-HW1-V2-FOUNDATION"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r0HashesRecomputedFromEntities",
        "oldWorktreeReadOnlyChecksPerformed",
        "scientificPayloadReadPerformed",
        "networkFetchPerformedAgainstOldWorktree",
        "heavyProbePerformed"
      ],
      "properties": {
        "r0HashesRecomputedFromEntities": {"const": true},
        "oldWorktreeReadOnlyChecksPerformed": {"const": true},
        "scientificPayloadReadPerformed": {"const": false},
        "networkFetchPerformedAgainstOldWorktree": {"const": false},
        "heavyProbePerformed": {"const": false}
      }
    }
  }
}
