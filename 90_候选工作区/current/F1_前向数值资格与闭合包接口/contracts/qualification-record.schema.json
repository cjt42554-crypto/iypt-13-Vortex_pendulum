{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iypt13:f1:qualification-record:v1",
  "title": "F1 synthetic numerical qualification record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "contractSha256",
    "implementationSha256",
    "inputSha256",
    "classification",
    "cases",
    "canonicalPayloadSha256",
    "decision"
  ],
  "properties": {
    "schemaVersion": {"const": "F1-QUALIFICATION-RECORD-v1"},
    "contractId": {"const": "VP-F1-SYNTHETIC-NUMERICAL-QUALIFICATION-CONTRACT-v1"},
    "contractSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "implementationSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inputSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "classification": {"const": "synthetic-only"},
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "referenceId", "metrics", "pass"],
        "properties": {
          "caseId": {"type": "string", "minLength": 1},
          "referenceId": {"type": "string", "minLength": 1},
          "metrics": {"type": "object"},
          "pass": {"type": "boolean"}
        }
      }
    },
    "canonicalPayloadSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {
      "enum": [
        "PASS-F1-SYNTHETIC-NUMERICAL-QUALIFICATION-ONLY",
        "NO-GO-F1-FORWARD-NUMERICAL-QUALIFICATION",
        "INCONCLUSIVE-F1-EVENT-OR-ENERGY-CONVERGENCE"
      ]
    }
  }
}
