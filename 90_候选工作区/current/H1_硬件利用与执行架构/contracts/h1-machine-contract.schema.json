{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iypt13:h1:machine-contract:v1",
  "title": "A8R HW1 result-blind machine contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "parentContractId",
    "phaseOrder",
    "serialReference",
    "fieldBoundary",
    "candidateClasses",
    "inventory",
    "probe",
    "gates",
    "equivalence",
    "shards",
    "provenanceLayers",
    "fullRuns",
    "failureCodes"
  ],
  "properties": {
    "contractId": {"const": "VP-A8R-HW1-MACHINE-CONTRACT-v1"},
    "parentContractId": {
      "const": "VP-A8R-HW1-RESULT-BLIND-HARDWARE-QUALIFICATION-CONTRACT-v1"
    },
    "phaseOrder": {
      "type": "array",
      "prefixItems": [
        {"const": "H0"},
        {"const": "H1"},
        {"const": "H2"},
        {"const": "H3"}
      ],
      "items": false
    },
    "serialReference": {"type": "object"},
    "fieldBoundary": {"type": "object"},
    "candidateClasses": {"type": "array", "minItems": 6, "uniqueItems": true},
    "inventory": {"type": "object"},
    "probe": {"type": "object"},
    "gates": {"type": "object"},
    "equivalence": {"type": "object"},
    "shards": {"type": "object"},
    "provenanceLayers": {
      "type": "array",
      "prefixItems": [
        {"const": "scientific"},
        {"const": "execution"},
        {"const": "artifact"}
      ],
      "items": false
    },
    "fullRuns": {"type": "object"},
    "failureCodes": {"type": "array", "minItems": 5, "uniqueItems": true}
  }
}
