{
  "name": "iypt-vortex-pendulum-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IYPT 2027 Problem 13 Vortex pendulum four-layer research platform",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && node scripts/desktop.mjs",
    "desktop:check": "node scripts/desktop.mjs --check",
    "desktop:install": "node scripts/install-desktop-launcher.mjs",
    "desktop:uninstall": "node scripts/uninstall-desktop-launcher.mjs",
    "simulate:forward": "vite-node scripts/run-forward.ts",
    "simulate:high-fidelity": "vite-node scripts/run-high-fidelity.ts",
    "audit:forward-convergence": "vite-node scripts/audit-forward-convergence.ts",
    "audit:high-fidelity": "vite-node scripts/audit-high-fidelity.ts",
    "analyze:high-fidelity-grid": "vite-node scripts/analyze-high-fidelity-grid.ts",
    "analyze:structure": "vite-node scripts/analyze-structure.ts",
    "analyze:cross-layer": "vite-node scripts/analyze-cross-layer.ts",
    "analyze:cross-layer:hf": "vite-node scripts/analyze-cross-layer.ts --mode=hf",
    "analyze:cross-layer:forward": "vite-node scripts/analyze-cross-layer.ts --mode=forward",
    "analyze:cross-layer:reuse": "vite-node scripts/analyze-cross-layer.ts --mode=all --reuse-existing",
    "plot:structure": "python3 scripts/plot-structure.py",
    "sweep:forward": "vite-node scripts/sweep-forward.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/e2e.mjs",
    "docs:check": "bash scripts/check-docs.sh",
    "validate": "npm run test && npm run build && npm run desktop:check && npm run test:e2e && npm run docs:check"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
