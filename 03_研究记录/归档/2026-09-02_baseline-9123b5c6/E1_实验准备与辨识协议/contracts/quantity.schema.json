{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iypt13:e1:quantity:v1",
  "title": "Traceable physical quantity",
  "type": "object",
  "additionalProperties": false,
  "required": ["value", "unit", "source", "observedAt", "standardUncertainty"],
  "properties": {
    "value": {"type": "number"},
    "unit": {"type": "string", "minLength": 1},
    "source": {
      "enum": [
        "measured",
        "calibrated",
        "derived-from-measured",
        "synthetic",
        "literature-prior"
      ]
    },
    "observedAt": {"type": "string", "format": "date-time"},
    "standardUncertainty": {"type": "number", "minimum": 0},
    "calibrationId": {"type": ["string", "null"]},
    "upstreamHashes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "uniqueItems": true
    }
  }
}
