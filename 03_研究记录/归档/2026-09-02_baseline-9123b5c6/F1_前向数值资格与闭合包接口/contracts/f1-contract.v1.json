  "apparatusCalibratedAllowedSources": ["measured-calibration", "holdout-validated-calibration"],
  "requiredCases": [
    "four-state-ode-convergence",
    "wet-geometry-analytic-reference",
    "conservative-energy-balance",
    "event-root-location",
    "variable-inertia-acceleration",
    "output-integration",
    "canonical-repeat",
    "coefficient-source-label"
