+      const validation = validateWakeGaugeConversionRequest(request(
+        source,
+        target,
+        scale as ConstantComplexWakeGaugeTransform,
+      ));
+      expect(validation.pass).toBe(false);
+    }
+    expect(() => transformWakeState({ wakeReal: 1, wakeImaginary: 2 }, {
+      real: 0,
+      imaginary: 0,
