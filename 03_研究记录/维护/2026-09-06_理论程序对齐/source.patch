diff --git "a/02_\346\250\241\346\213\237\347\250\213\345\272\217/src/solvers/forward/stick-slip.ts" "b/02_\346\250\241\346\213\237\347\250\213\345\272\217/src/solvers/forward/stick-slip.ts"
