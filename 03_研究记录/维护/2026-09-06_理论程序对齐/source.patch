+      drivingTorque: 0,
+      staticFrictionTorque: 0,
+      kineticFrictionTorque: 0,
+      viscousDamping: 0,
+      omega: 0,
+    })).toThrow(/positive/);
+    expect(() => restartStickSlipAtRest(
+      { omega: Number.MIN_VALUE },
+      0,
+      0,
+    )).toThrow(/omega=0/);
+  });
+});
